# Nuvra configuration
# Copiez ce fichier en .env et remplissez les valeurs
PORT=5173
JWT_SECRET=changez_moi_avec_une_valeur_securisee_longue
NODE_ENV=development
# Clé Stripe (test par défaut, remplacez par votre clé)
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Domaine public pour les URLs de callback
APP_URL=http://localhost:5173
# Stockage des fichiers
UPLOAD_DIR=./data/uploads
DB_PATH=./data/nuvra.db
